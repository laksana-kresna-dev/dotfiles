{{- $hasDiff := false -}}
{{- $files := list -}}

{{- if hasKey .chezmoi "git" -}}
  {{- if .chezmoi.git.diff -}}
    {{- $hasDiff = true -}}
    {{- $files = .chezmoi.git.diff -}}
  {{- end -}}
{{- end -}}

{{ promptString "Commit message (feat: new feature | fix: bug | refactor: rewrite | docs: documentation | style: formatting | chore: maintenance)" }}

{{ if $hasDiff -}}
Updated files:
{{ range $files -}}
- {{ . }}
{{ end }}
Author: {{ .chezmoi.username }}@{{ .chezmoi.hostname }}
{{- else -}}
Author: {{ .chezmoi.username }}@{{ .chezmoi.hostname }}
{{- end -}}
