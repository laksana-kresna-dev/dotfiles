# Ignore documentation and git assets from home directory
README.md
LICENSE
.git
.gitignore

# Ignore setup scripts from being copied directly to $HOME
.install-password-manager.sh

# OS-Specific Conditions
{{ if ne .chezmoi.os "linux" }}
.config/i3
.config/sway
{{ end }}

# Temporary/Cache files
**/*.tmp
**/*.log

# Ignore unencrypted SSH private keys
.ssh/id_rsa
.ssh/id_ed25519
.ssh/id_ecdsa
!.ssh/*.pub

# Ignore GPG private keys dump
*.gpg-key
private-keys-v1.d/

# Ignore KeepassXC database files & master keys
*.kdbx
*.key
